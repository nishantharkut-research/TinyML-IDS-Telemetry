{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishantharkut/TinyML-IDS-Telemetry/tinyml_ids_telemetry/schemas/telemetry-event-v1.schema.json",
  "title": "TinyML IDS source telemetry event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_event_id",
    "lineage_id",
    "source_session_id",
    "source_stage_id",
    "row_id",
    "source_row_index",
    "board",
    "student_model",
    "status",
    "true_class_id",
    "true_class_name",
    "predicted_class_id",
    "predicted_class_name",
    "fixed_predicted_class_id",
    "fp32_predicted_class_id",
    "normal_class_id",
    "is_predicted_attack",
    "fixed_logits",
    "logit_frac_bits",
    "normalized_logit_margin",
    "preprocess_us",
    "inference_us",
    "total_us",
    "attempts",
    "response_timeout_count",
    "ignored_datagram_count",
    "ignored_wrong_endpoint_count",
    "ignored_bad_length_count",
    "ignored_non_ascii_count",
    "ignored_malformed_count",
    "ignored_bad_prefix_count",
    "ignored_bad_identity_count",
    "ignored_bad_attempt_count",
    "ignored_bad_inner_hex_count",
    "ignored_bad_crc_count",
    "ignored_bad_inner_text_count",
    "ignored_wrong_session_count",
    "ignored_wrong_stage_count",
    "ignored_wrong_transaction_count",
    "ignored_wrong_attempt_count",
    "successful_request_bytes",
    "request_datagram_bytes_sent",
    "response_bytes",
    "host_observed_datagram_rtt_us",
    "transaction_elapsed_us",
    "mcu_fixed_prediction_match",
    "mcu_fixed_logits_match"
  ],
  "properties": {
    "schema_version": { "const": "telemetry-event-v1" },
    "source_event_id": { "$ref": "#/$defs/sha256" },
    "lineage_id": { "$ref": "#/$defs/sha256" },
    "source_session_id": { "$ref": "#/$defs/nonEmptyString" },
    "source_stage_id": { "$ref": "#/$defs/nonEmptyString" },
    "row_id": { "$ref": "#/$defs/nonNegativeInteger" },
    "source_row_index": { "$ref": "#/$defs/nonNegativeInteger" },
    "board": { "$ref": "#/$defs/nonEmptyString" },
    "student_model": { "$ref": "#/$defs/nonEmptyString" },
    "status": { "$ref": "#/$defs/nonEmptyString" },
    "true_class_id": { "$ref": "#/$defs/classId" },
    "true_class_name": { "$ref": "#/$defs/nonEmptyString" },
    "predicted_class_id": { "$ref": "#/$defs/classId" },
    "predicted_class_name": { "$ref": "#/$defs/nonEmptyString" },
    "fixed_predicted_class_id": { "$ref": "#/$defs/classId" },
    "fp32_predicted_class_id": { "$ref": "#/$defs/classId" },
    "normal_class_id": { "$ref": "#/$defs/classId" },
    "is_predicted_attack": { "type": "boolean" },
    "fixed_logits": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 5,
      "maxItems": 5
    },
    "logit_frac_bits": { "$ref": "#/$defs/nonNegativeInteger" },
    "normalized_logit_margin": { "type": "number", "minimum": 0 },
    "preprocess_us": { "$ref": "#/$defs/nonNegativeInteger" },
    "inference_us": { "$ref": "#/$defs/nonNegativeInteger" },
    "total_us": { "$ref": "#/$defs/nonNegativeInteger" },
    "attempts": { "type": "integer", "minimum": 1 },
    "response_timeout_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_datagram_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_wrong_endpoint_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_bad_length_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_non_ascii_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_malformed_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_bad_prefix_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_bad_identity_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_bad_attempt_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_bad_inner_hex_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_bad_crc_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_bad_inner_text_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_wrong_session_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_wrong_stage_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_wrong_transaction_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "ignored_wrong_attempt_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "successful_request_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
    "request_datagram_bytes_sent": { "$ref": "#/$defs/nonNegativeInteger" },
    "response_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
    "host_observed_datagram_rtt_us": { "$ref": "#/$defs/nonNegativeInteger" },
    "transaction_elapsed_us": { "$ref": "#/$defs/nonNegativeInteger" },
    "mcu_fixed_prediction_match": { "const": true },
    "mcu_fixed_logits_match": { "const": true }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "classId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    }
  }
}
