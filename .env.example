CUKD_XAI_ROOT=C:/path/to/CuKD-XAI

# All generated outputs must remain outside CUKD_XAI_ROOT.
TELEMETRY_ARTIFACT_ROOT=./artifacts

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TELEMETRY_TOPIC=ids.telemetry.raw
INVALID_TOPIC=ids.telemetry.invalid
ALERT_TOPIC=ids.telemetry.alerts

