# Normal runtime root: the verified evidence bundle copied into this project.
TINYML_IDS_EVIDENCE_ROOT=./data/source-evidence

# One-time import source. The importer treats this repository as read-only.
CUKD_XAI_ROOT=C:/path/to/CuKD-XAI

# Generated outputs must remain outside both evidence roots.
TELEMETRY_ARTIFACT_ROOT=./artifacts

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TELEMETRY_TOPIC=ids.telemetry.raw
INVALID_TOPIC=ids.telemetry.invalid
ALERT_TOPIC=ids.telemetry.alerts
